    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Assemble the AgentForge report payload from the completed step outputs.\n// Each entry in step_node_names is an AgentForge step HTTP node; its response\n// holds that subtask's result from the AgentForge backend.\nvar step_node_names = [\n  'Run Step [planner]: Frame the research questions and plan',\n  'Run Step [researcher]: Gather market and competitor context',\n  'Run Step [analyst]: Profile the dataset and extract trends',\n  'Run Step [forecaster]: Project demand trend for the next period',\n  'Run Step [critic]: Stress-test claims and rank recommendations'\n];\nvar mission = $('Mission Context').first().json;\nvar steps = [];\nfor (var i = 0; i < step_node_names.length; i++) {\n  var node_name = step_node_names[i];\n  var output = null;\n  try {\n    output = $(node_name).first().json;\n  } catch (error) {\n    output = { error: 'no output from ' + node_name };\n  }\n  steps.push({ node: node_name, data: output });\n}\nvar report = {\n  run_id: mission.run_id,\n  mission_id: mission.mission_id,\n  goal: mission.goal,\n  template_id: mission.template_id || null,\n  step_count: steps.length,\n  steps: steps,\n  api_url: mission.api_url,\n  source: 'agentforge-n8n-export'\n};\nreturn [{ json: report }];\n"
      },
      "id": "4a47087e-97e6-5265-8682-5113fc26ecd9",
      "name": "Assemble Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.api_url }}/api/runs/{{ $json.run_id }}/report",
        "sendBody": true,
