    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Assemble the AgentForge report payload from the completed step outputs.\n// Each entry in step_node_names is an AgentForge step HTTP node; its response\n// holds that subtask's result from the AgentForge backend.\nvar step_node_names = [\n  'Run Step [planner]: Frame the sales questions and plan',\n  'Run Step [researcher]: Collect KPI and seasonality context',\n  'Run Step [analyst]: Profile sales data and find drivers',\n  'Run Step [forecaster]: Forecast next-period revenue',\n  'Run Step [critic]: Validate findings and rank fixes'\n];\nvar mission = $('Mission Context').first().json;\nvar steps = [];\nfor (var i = 0; i < step_node_names.length; i++) {\n  var node_name = step_node_names[i];\n  var output = null;\n  try {\n    output = $(node_name).first().json;\n  } catch (error) {\n    output = { error: 'no output from ' + node_name };\n  }\n  steps.push({ node: node_name, data: output });\n}\nvar report = {\n  run_id: mission.run_id,\n  mission_id: mission.mission_id,\n  goal: mission.goal,\n  template_id: mission.template_id || null,\n  step_count: steps.length,\n  steps: steps,\n  api_url: mission.api_url,\n  source: 'agentforge-n8n-export'\n};\nreturn [{ json: report }];\n"
      },
      "id": "394fff72-ab04-5453-8fe2-c772b64b5b81",
      "name": "Assemble Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2660,
        0
      ]
    },
    {
