# ── AgentForge environment ──────────────────────────────────────────────
# Copy to backend/.env (backend vars) and frontend/.env.local (NEXT_PUBLIC_*).
# NEVER commit a real .env. All values below are examples, not secrets.

# ── LLM provider (OpenAI-compatible; default GLM / Zhipu) ───────────────
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash
LLM_FALLBACK_MODEL=glm-4-flash
LLM_MODE=mock              # live | mock  (mock = deterministic offline responses)
LLM_TIMEOUT_SECONDS=60

# ── Backend ──────────────────────────────────────────────────────────────
API_KEY=                   # optional; empty = guest mode (no auth required)
RUN_MODE=demo              # demo | live  (demo = simulated run, no LLM needed)
DEMO_RUN_SPEED=1.0         # demo pacing: divides scripted delays (1.0 ≈ 33 s watchable run; higher = faster)
DATABASE_URL=sqlite:///./agentforge.db
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports  # generated report downloads (markdown/pdf)
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:3000

# ── Realtime / token-cost meter ──────────────────────────────────────────
COST_PER_1M_INPUT_TOKENS=0.11    # USD per 1M input tokens (used for estimates)
COST_PER_1M_OUTPUT_TOKENS=0.11   # USD per 1M output tokens

# ── Tools ────────────────────────────────────────────────────────────────
BRAVE_API_KEY=             # optional; DuckDuckGo search provider needs no key
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_MEMORY_MB=256

# ── Frontend (put these in frontend/.env.local) ──────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_WS_URL=ws://localhost:8000
NEXT_PUBLIC_DEMO_MODE=1    # 1 = UI runs fully offline on built-in mock data
